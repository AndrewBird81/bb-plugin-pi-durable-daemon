{
  "compilerOptions": {
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "src",
    "test"
  ],
  "exclude": [
    "test/daemon-fixture.ts"
  ]
}
